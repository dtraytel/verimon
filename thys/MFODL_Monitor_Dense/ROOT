chapter AFP

session MFODL_Monitor_Dense = MFODL_Monitor_Devel +
  description
    "The monitor the shipping binary runs. Dense_VeriMon prepares the formula as VeriMon does,
     rewrites it (Dense_Frz, Dense_Push, Dense_Share) and runs the kernel of session
     MFODL_Monitor_Devel on it. Monitor_Code_Dense is the code export the binary is built
     from (src/verified.ml), together with the verified log parser of session Log_Parser;
     Log_Monitor composes the two, from the bytes of the log to the verdicts, and
     Log_Monitor_Online states its correctness for the online interface."
  sessions
    Log_Parser
  theories
    Kernel_Code
    Table_Evt
    Since_Evt
    Until_Evt
    Dense_Utuple
    Dense
    Dense_Aux
    Dense_Until_Gen
    Dense_Evt
    Dense_Agg_Gen
    Dense_Idx
    Dense_Tree_Code
    Dense_Win
    Dense_Win_Agg
    Dense_Maux
    Dense_Frz
    Dense_Share
    Dense_Push
    Dense_VeriMon
    Dense_Mono
    Log_Monitor
    Log_Monitor_Online
  theories [document=false]
    Monitor_Code_Dense
  export_files (in ".") [2]
    "MFODL_Monitor_Dense.Monitor_Code_Dense:code/**"
