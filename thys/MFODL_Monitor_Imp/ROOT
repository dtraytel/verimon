chapter AFP

session MFODL_Monitor_Imp = MFODL_Monitor_Dense +
  description
    "Imperative refinement of the Since structure and of the monitor's evaluation function.
     Separate session so that the base session, whose heap image it reuses, does not have to be
     rebuilt when the refinement changes."
  theories
    Table_Imp
    Imap_Correct
    Optimized_Since_Imp
    Since_Imp2
    Join_Imp2
    Until_Imp2
    Monitor_Imp2
    Dense_Imp
    Dense_Join_Correct
    Dense_Code_Opt
    Monitor_Imp
  theories [document=false]
    Monitor_Code_Imp
    Monitor_Code_Imp_Only
  export_files (in ".") [2]
    "MFODL_Monitor_Imp.Monitor_Code_Imp:code/**"
    "MFODL_Monitor_Imp.Monitor_Code_Imp_Only:code/**"
