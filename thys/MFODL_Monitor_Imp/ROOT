chapter AFP

session MFODL_Monitor_Imp = MFODL_Monitor_Devel +
  description
    "Imperative refinement of the Since structure and of the monitor's evaluation function.
     Separate session so that the base session, whose heap image it reuses, does not have to be
     rebuilt when the refinement changes."
  theories
    Table_Imp
    Optimized_Since_Imp
    Since_Imp2
    Join_Imp2
    Until_Imp2
    Monitor_Imp2
    Dense
    Dense_Eval
    Dense_Produces
    Dense_Match
    Dense_Let
    Dense_Agg
    Dense_Correct
    Dense_Compile
    Dense_Init
    Dense_Descend
    Dense_Imp
    Monitor_Imp
  theories [document=false]
    Monitor_Code_Imp
  export_files (in ".") [2]
    "MFODL_Monitor_Imp.Monitor_Code_Imp:code/**"
