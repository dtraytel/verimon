chapter AFP

session VeriMon_Parsers = MFODL_Parser_Code +
  description
    "The parsers of the monitor's inputs, which do not depend on the monitoring algorithm: the
     verified formula parser (sessions MFODL_Grammar, MFODL_Parser and MFODL_Parser_Code, built
     with the grammar package) and the verified log parser (session Log_Parser), together with
     the library session Containers.  The formula parser, by far the slowest of them, is the
     parent, so that a build of all sessions checks it only once; Containers and the log parser
     are checked here again.  The monitor's sessions build on this heap, so that a change to the
     monitor does not check the parsers again."
  options [timeout = 0]
  sessions
    Deriving
    Containers
    MFODL_Syntax
    Log_Parser
  theories
    "Deriving.Derive"
    "Deriving.Comparator"
    "Deriving.RBT_Comparator_Impl"
    "Containers.Containers"
    "MFODL_Syntax.Surface_Postprocessing"
    "MFODL_Syntax.String_Escape"
    "MFODL_Syntax.Byte_String"
    "Log_Parser.Log_OCaml"
