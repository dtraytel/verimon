chapter AFP

session VeriMon_Parsers = Containers +
  description
    "The parsers of the monitor's inputs, which do not depend on the monitoring algorithm: the
     verified log parser (session Log_Parser) and the verified formula parser (sessions
     MFODL_Grammar, MFODL_Parser and MFODL_Parser_Code, built with the grammar package). They are
     collected into one heap at the bottom of the monitor's sessions, so that a change to the
     monitor does not check them again."
  options [timeout = 0]
  sessions
    Log_Parser
    MFODL_Parser_Code
  theories
    "Log_Parser.Log_Code"
    "MFODL_Parser_Code.MFODL_Parser_Code"
