; The code generated from the Isabelle/HOL formalization (thys/VeriMon_CLI, theory CLI_Code):
; the formula parser, the signature reader, the log parser and the monitor in one module, with
; the few functions CLI_Code implements in OCaml (verimon_runtime.ml). It is not meant to be
; edited, so its (many, harmless) compiler warnings are silenced.
(library
  (name verimon_code)
  (wrapped false)
  (libraries zarith)
  (flags (:standard -w -a))
  (modules verimon_code verimon_runtime))

(executable
  (name verimon)
  (public_name verimon)
  (package verimon)
  (libraries zarith verimon_code dune-build-info)
  (modules verimon verimon_io))
