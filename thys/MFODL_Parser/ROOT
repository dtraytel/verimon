chapter AFP

session MFODL_Grammar = TIGER_Lexer_Parser +
  description
    "The grammar of MonPoly's formula syntax, with its semantic actions and the
     relation it defines (a separate session because the grammar command is slow)."
  options [timeout = 7200]
  sessions
    MFODL_Syntax
  theories
    MFODL_Grammar

session MFODL_Parser in Parser = MFODL_Grammar +
  description
    "A verified lexer and parser for MonPoly's formula syntax, generated by the lexer and
     parser commands of TIGER_Lexer_Parser."
  options [timeout = 0]
  sessions
    MFODL_Syntax
  theories
    MFODL_Lexer
    MFODL_Parser

session MFODL_Parser_Code in "Parser/Code" = MFODL_Parser +
  description
    "Code equations for the semantic actions, and examples of the verified parser checked by
     evaluation."
  theories
    MFODL_Efficient_Actions
    MFODL_Parser_Examples
