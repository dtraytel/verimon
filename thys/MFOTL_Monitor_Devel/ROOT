chapter AFP

session MFOTL_Monitor_Devel (AFP) = VeriMon_Parsers +
  description
    "The base of the logic: traces, intervals, tables, the event data and the abstract
     specification of a monitor, which neither the logic nor any monitoring algorithm changes.
     The development version of the AFP entry MFOTL_Monitor; session Generic_Join_Devel
     imports its theory Table."
  options [timeout = 1200]
  sessions
    IEEE_Floating_Point
  theories
    Trace
    Table
    Abstract_Monitor
    Interval
    Preliminaries
    Code_Double
    Event_Data
  document_files
    "root.tex"
    "root.bib"
