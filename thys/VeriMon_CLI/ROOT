chapter AFP

session VeriMon_CLI = MFODL_Monitor_Exec +
  description
    "The verified monitor with MonPoly's command line: the verified formula parser (session
     MFODL_Parser), a verified reader of the signature, the conversion of the parsed formula into
     the monitor's, and the monitor on the log (session MFODL_Monitor_Exec), composed with the
     decisions of MonPoly's front end; CLI_Code is the code export of the program verimon
     (src/verimon_code.ml)."
  options [document = false, timeout = 0]
  sessions
    MFODL_Frontend
  theories
    CLI_Options
    CLI_Output
    CLI
    CLI_Code
  export_files (in ".") [2]
    "VeriMon_CLI.CLI_Code:code/**"
