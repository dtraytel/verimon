; Microbenchmark isolating the constant factors of the generated (verified) set
; operations: dictionary construction, comparator dispatch, persistent RBT vs. Hashtbl.
; See ../../EFFICIENCY.md. The generated module is copied with its signature removed so
; that internal functions can be called.
(rule
 (target verified_open.ml)
 (deps ../../src/verified.ml)
 (action
  (with-stdout-to %{target}
   (run sed -e "/^module Monitor : sig$/,/^end = struct$/c\\module Monitor = struct" %{deps}))))

(executable
 (name micro)
 (libraries zarith unix)
 (flags (:standard -w -a))
 (modules verified_open micro))
